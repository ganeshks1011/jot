# Copy to .env and fill in values (same Firebase project as the web app's
# root .env — the extension signs in with custom tokens minted by the
# Wurkflo backend, which are project-bound). Never commit .env. Rebuild
# the extension after changing it (Vite bakes env at build time).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
